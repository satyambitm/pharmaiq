# Copy this file to .env and fill in real values. Never commit .env.
# The database default matches the local-only docker-compose.yml Postgres container.

# --- Shared (pipeline scripts and API) ---
DATABASE_URL=postgresql+psycopg://pharmaiq_user:pharmaiq_local@localhost:5432/pharmaiq
RANDOM_SEED=42
DATA_DIR=data
ARTIFACT_DIR=artifacts

# --- FastAPI backend ---
# postgres: read monthly_sales from DATABASE_URL.  csv: serve data/sample/synthetic_sales_clean.csv (no database).
DATA_BACKEND=postgres
ENVIRONMENT=development
LOG_LEVEL=INFO
# If true and the sales table is missing or empty, load the bundled demo CSV at startup.
AUTO_SEED_DEMO=false

# --- Bring-your-own-data uploads (see docs/byod.md) ---
# disabled: no uploads (default; the public deployment).  local: single-user dev mode, no auth, refused in production.
# api_key: every request needs X-API-Key; API_KEYS holds "owner:sha256hex" pairs from scripts/make_api_key.py.
UPLOADS_MODE=disabled
# API_KEYS=alice:<sha256 hex>,bob:<sha256 hex>
# Where uploaded files and ingested rows are stored. Defaults to DATABASE_URL. A SQLite URL works for local dev:
# DATASET_STORE_URL=sqlite:///./byod_dev.db
MAX_UPLOAD_MB=5
MAX_UPLOAD_ROWS=200000
MAX_DATASETS_PER_OWNER=10
# Training requests per owner per 24 h. Jobs are run by `python -m ml.byod_worker`, never by the API.
MAX_TRAINING_JOBS_PER_DAY=5

# --- Streamlit frontend ---
# Local development only. In deployments set this in Streamlit Cloud Secrets to the public HTTPS API URL.
API_BASE_URL=http://localhost:8000
